# ========================================================
# YUVI DECORATION - Environment Configuration
# ========================================================

# Server Configuration
PORT=3000
APP_BASE_URL=http://localhost:3000

# Admin Dashboard Credentials
ADMIN_EMAIL=admin@yuvidecoration.com
ADMIN_PASSWORD=your_secure_password_here

# MongoDB Atlas Database URI (Optional - If omitted, local JSON storage is used automatically)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/yuvidecoration?retryWrites=true&w=majority

# Google Gemini API Key (Optional - If omitted, smart rule-based AI is used automatically)
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================================
# Meta WhatsApp Cloud API Configuration (Official API)
# ========================================================
# 1. Obtain from https://developers.facebook.com -> Your App -> WhatsApp -> API Setup
# 2. Permanent System User Access Token with 'whatsapp_business_messaging' permission
WHATSAPP_ACCESS_TOKEN=EAAG...your_meta_access_token_here

# 3. Phone Number ID from Meta WhatsApp API Setup Dashboard
WHATSAPP_PHONE_NUMBER_ID=100000000000000

# 4. WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000000

# 5. Admin WhatsApp Number (with country code, no + or spaces, e.g. 919263667669)
WHATSAPP_ADMIN_NUMBER=919263667669

# 6. Approved WhatsApp Template Name (Optional, for 24h window bypass)
WHATSAPP_TEMPLATE_NAME=yuvi_booking_confirmation

